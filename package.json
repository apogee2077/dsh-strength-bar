{
  "name": "@local/dsh-strength-bar",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "ChatGPT-style strength slider above the DSH composer for model, reasoning effort and agent preset.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apogee2077/dsh-strength-bar.git"
  },
  "homepage": "https://github.com/apogee2077/dsh-strength-bar#readme",
  "bugs": {
    "url": "https://github.com/apogee2077/dsh-strength-bar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "slider",
    "chatgpt"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-agent-preset"
      ]
    }
  }
}
